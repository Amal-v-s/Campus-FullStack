{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "build": "find src -type f -name '*.js' -exec node --check {} \\; && node --check cors.js && node --check server.js",
    "lint": "npm run build",
    "start": "node server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:demo": "node src/db/seed-demo.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  }
}
