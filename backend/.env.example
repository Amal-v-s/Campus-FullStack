PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated allowlist for multiple frontends; takes precedence over CLIENT_ORIGIN.
# Example: CLIENT_ORIGINS=http://localhost:5173,https://campus.example.edu
# CLIENT_ORIGINS=

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=campus_ai
DB_USER=campus_user
DB_PASSWORD=campus_password

# Admin Seed Credentials
ADMIN_EMAIL=admin@campus.local
ADMIN_PASSWORD=campus123

# JWT Configuration
JWT_SECRET=super-secret-campus-ai-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

